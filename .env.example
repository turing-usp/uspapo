# ─────────────────────────────────────────────
# USPapo — variáveis de ambiente do backend e do pipeline de dados
# Copie para .env e preencha. O .env NÃO vai para o git.
# ─────────────────────────────────────────────

# Pinecone — obrigatório para backend/app.py (o backend/app_stub.py não usa).
PINECONE_API_KEY=

# O backend e o pipeline leem o mesmo par. Manter os dois lados na mesma
# variável é o que permite construir um índice novo em paralelo e só depois
# virar a chave, sem tocar em código.
PINECONE_INDEX=uspapo-rag
PINECONE_NAMESPACE=uspapo

# ─────────────────────────────────────────────
# Pipeline de dados (scrapers + embeddings)
#
# Nada abaixo é obrigatório: o config_vetor.py traz um default para cada um.
# Estão aqui porque são as manoplas que alguém pode precisar girar num incidente.
# ─────────────────────────────────────────────

# Calcula o plano e salva o ledger local, sem escrever uma linha na nuvem.
DRY_RUN=0

# Disjuntor de escrita. Foi a falta dele que deixou um erro a montante, um
# domínio invadido, com 400 mil URLs de spam, virar estouro de cota no Pinecone.
# As duas primeiras travas são tetos absolutos; a terceira é proporcional, e é a
# que responde "isto é rotina ou é migração?".
ORCAMENTO_UPSERTS=2000
ORCAMENTO_DELETES=3000
LIMIAR_ABORTO_PCT=0.25

# Desliga o disjuntor. É para o rebuild completo, na mão de alguém que sabe o
# que vai acontecer: nunca no cron.
PERMITIR_MIGRACAO_TOTAL=0

# Chunking, em caracteres. O e5 corta em 512 tokens (~1.800 chars em pt-BR).
CHUNK_ALVO=800
CHUNK_MAX=1100
CHUNK_MIN=200
CHUNK_OVERLAP=150

# ─────────────────────────────────────────────
# Cadeia de provedores de LLM, em ordem de prioridade.
#
# JSON em UMA linha só. O primeiro da lista é o primário; se ele falhar
# (rate limit, timeout, 5xx, chave inválida), o backend cai automaticamente
# para o próximo. Pode ter quantos você quiser.
#
# Qualquer API compatível com o protocolo OpenAI serve: Groq, OpenRouter,
# DeepSeek, OpenAI, Together, Cerebras, Ollama/LM Studio local...
#
# Campos obrigatórios por provedor:
#   nome       rótulo usado nos logs e no /health
#   base_url   endpoint compatível com OpenAI (termina em /v1)
#   model      id do modelo nesse provedor
#   api_key    valor da chave, colado aqui dentro mesmo (não existe mais o
#              api_key_env apontando para outra variável). Provedor com
#              api_key vazia é ignorado ao subir o servidor.
#
# Campos opcionais por provedor:
#   temperature  padrão 0.1
#   max_tokens   padrão: o do provedor
#   timeout      segundos, padrão 60
#   max_tokens_contexto
#                teto de contexto SÓ deste provedor, sobrepondo o
#                MAX_TOKENS_CONTEXTO lá embaixo. Existe porque o padrão é
#                calibrado para o modelo local, que aceita o que mandarmos,
#                enquanto uma API cobrada por token tem uma janela por minuto
#                bem menor e RECUSA a requisição inteira (HTTP 413,
#                "request_too_large") quando ela sozinha passa do limite. Se o
#                log mostrar 413 nesse provedor, é este número que precisa
#                baixar. O backend também reduz sozinho e tenta de novo, mas
#                começar no valor certo economiza a ida perdida.
#   extra_body   dict repassado cru na requisição, para flags fora do padrão
#                OpenAI (ex.: "reasoning_format" da Groq, que faz os tokens de
#                raciocínio virem separados do texto final). Atenção: nos
#                modelos gpt-oss a Groq NÃO aceita "reasoning_format", lá a
#                flag equivalente é "include_reasoning". O backend já lê o
#                raciocínio de qualquer um dos campos, então na dúvida deixe
#                o extra_body de fora. Ainda nos gpt-oss, um
#                {"reasoning_effort":"low"} aqui corta bastante o token gasto
#                por pergunta, que é o que estoura a cota da Groq mais rápido.
#
# Quando um provedor falha, o backend distingue o motivo: cota estourada (429)
# é esperada com o Retry-After que o próprio provedor mandou; recusa por
# tamanho (413) é refeita com menos contexto; chave ou modelo errado (401/403/
# 404) descarta o provedor por cinco minutos, porque isso não passa sozinho.
# Quem falhou fica no fim da fila da cadeia pelo tempo do castigo. O /health
# mostra quanto falta de cada um.
#
# Encadear vários modelos da MESMA chave protege contra a cota de um modelo,
# não contra um problema da chave: se a causa for 401 ou a cota da organização,
# todos os elos caem pelo mesmo motivo. Para redundância de verdade, misture
# provedores diferentes.
# ─────────────────────────────────────────────
# A cadeia abaixo é a medida no tier gratuito da Groq (agosto/2026). O TPM é
# POR MODELO, então encadear modelos diferentes da mesma chave dá folga de
# verdade contra cota — só não protege de um problema da chave em si.
#
#   modelo                     TPM     req/dia   max_tokens_contexto
#   openai/gpt-oss-120b        8.000     1.000         6000
#   llama-3.3-70b-versatile   12.000     1.000         8000
#   openai/gpt-oss-20b         8.000     1.000         6000
#   qwen/qwen3.6-27b           8.000     1.000         6000
#   llama-3.1-8b-instant       6.000    14.400         4500
#
# O llama-3.1-8b fica por último de propósito: é o mais fraco, mas tem 14x mais
# requisições por dia que os outros, então é o que ainda responde quando o
# resto bateu no teto diário. Confira o TPM da SUA chave antes de copiar: ele
# muda por tier, e é dele que sai o max_tokens_contexto (~75% do TPM, para
# sobrar espaço para a segunda rodada de ferramenta no mesmo minuto).
LLM_PROVIDERS=[{"nome":"groq-gptoss120","base_url":"https://api.groq.com/openai/v1","api_key":"","model":"openai/gpt-oss-120b","temperature":0.1,"max_tokens_contexto":6000},{"nome":"groq-llama70","base_url":"https://api.groq.com/openai/v1","api_key":"","model":"llama-3.3-70b-versatile","temperature":0.1,"max_tokens_contexto":8000},{"nome":"groq-gptoss20","base_url":"https://api.groq.com/openai/v1","api_key":"","model":"openai/gpt-oss-20b","temperature":0.1,"max_tokens_contexto":6000},{"nome":"groq-qwen27","base_url":"https://api.groq.com/openai/v1","api_key":"","model":"qwen/qwen3.6-27b","temperature":0.1,"max_tokens_contexto":6000},{"nome":"groq-llama8","base_url":"https://api.groq.com/openai/v1","api_key":"","model":"llama-3.1-8b-instant","temperature":0.1,"max_tokens_contexto":4500}]

# ─────────────────────────────────────────────
# Contas: a URL do projeto Supabase. O login no /chat é OBRIGATÓRIO.
#
# É a mesma URL do NEXT_PUBLIC_SUPABASE_URL do site (Project Settings > API),
# e dela o backend monta o endereço do JWKS:
#
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#
# O Supabase assina o token de login com chave ASSIMÉTRICA (ES256, ou RS256 em
# projeto mais antigo) e publica a parte pública nesse endereço. O backend baixa
# essa chave, guarda por 10 minutos e confere a assinatura sozinho.
#
# Vazio aqui: NINGUÉM consegue perguntar (o /chat devolve 503). Sem PyJWT[crypto]
# instalado, idem, a validação ES256 depende do pacote `cryptography`.
#
# PARA DESENVOLVER SEM O PROJETO DE PRODUÇÃO, use o Supabase local. A pasta
# supabase/ é ignorada pelo git, então cada um monta a sua:
#
#     supabase init
#     supabase gen signing-key --algorithm ES256 > supabase/signing_keys.json
#     supabase start
#
# O esquema (Perfis, conversas, mensagens) não vem do nada: `supabase link
# --project-ref <ref>` e `supabase db pull`, senão o site quebra na primeira
# consulta com "relation public.conversas does not exist".
#
# Depois de subir, o SUPABASE_URL local é http://127.0.0.1:54321 (e a
# publishable key que o start imprime vai no site/.env.local).
# ─────────────────────────────────────────────
SUPABASE_URL=

# ─────────────────────────────────────────────
# Whitelist: quem pode usar o USPapo, por email da conta.
#
# O email sai do próprio token já conferido acima, então a lista vale para a
# pessoa e não para o navegador. Três formas de escrever:
#
#   todos                      qualquer conta logada entra. É o padrão, e é a
#                              whitelist efetivamente desligada, mas o login
#                              continua obrigatório.
#   ninguem                    ninguém entra, nem quem está logado. O USPapo
#                              fica fechado (403 para todo mundo).
#   a@usp.br, @turingusp.com   só quem está na lista. A entrada começando com @
#                              libera o domínio inteiro.
#
# Vazia vale "todos": um valor em branco por acidente não pode derrubar o site.
#
# ATENÇÃO ao usar domínio (@usp.br): quem passa a controlar o acesso é o cadastro
# do Supabase. Com "Confirm email" DESLIGADO no painel, qualquer pessoa se
# cadastra como fulano@usp.br sem ter a caixa e entra. Ligue a confirmação de
# email antes de confiar numa regra de domínio.
# ─────────────────────────────────────────────
WHITELIST_EMAILS=todos

# ─────────────────────────────────────────────
# Rate limit: quantas perguntas cada conta pode fazer por janela.
#
# Uma escada só: como o login é obrigatório, todo mundo que chega no /chat já
# provou a conta, e a cota vale para a pessoa, acompanha ela entre celular e
# computador.
#
# As quatro janelas valem ao mesmo tempo: a de minuto segura a rajada, a de dia
# segura o uso crônico. Ponha 0 para desligar uma delas. Estourar devolve 429.
#
# AS QUATRO EM 0 DESLIGAM O RATE LIMIT INTEIRO: quem segura a porta é a whitelist,
# e limitar quem foi convidado a dedo só atrapalha.
# A conta nem chega a ser registrada nesse caso.
#
#   WHITELIST_EMAILS=fulano@usp.br, @turingusp.com
#   RATE_LIMIT_MINUTO=0
#   RATE_LIMIT_10MIN=0
#   RATE_LIMIT_HORA=0
#   RATE_LIMIT_DIA=0
# ─────────────────────────────────────────────
RATE_LIMIT_MINUTO=15
RATE_LIMIT_10MIN=80
RATE_LIMIT_HORA=300
RATE_LIMIT_DIA=1200

# ─────────────────────────────────────────────
# Orçamento de contexto — teto do que é enviado ao modelo em cada pergunta,
# não importa o tamanho da conversa acumulada no frontend. O histórico é
# cortado do turno mais antigo para o mais novo até caber; a pergunta atual
# nunca é descartada (se ela sozinha estourar, é truncada).
#
# MAX_TOKENS_CONTEXTO é o teto padrão. Um provedor pode ter o seu, menor, pelo
# max_tokens_contexto lá em cima — é o que acomoda uma API com janela por
# minuto apertada sem encolher o modelo local junto.
#
# RESERVA_FERRAMENTAS é o espaço guardado para o que as buscas ainda vão
# devolver nesta mesma pergunta — sem ela, o contexto enche antes do RAG rodar.
# Ela diz quanto as FERRAMENTAS precisam, o que depende delas e não do modelo:
# uma grade curricular completa dá ~2.600 tokens, o cardápio da semana dos
# quatro bandejões ~2.300.
#
# Só que o que elas precisam nem sempre é o que cabe: num teto de 6.000 uma
# reserva de 4.000 não deixaria espaço nem para a pergunta. Por isso vale o
# MENOR entre este número e um terço do teto em vigor. Na prática:
#
#   teto 16.000 (local) -> reserva 4.000, este valor aqui manda
#   teto 12.000         -> reserva 4.000, este valor aqui manda
#   teto  8.000 ou menos-> reserva = teto/3, a fração manda
#
# Ou seja: mexer aqui muda o modelo local; para os provedores de teto apertado
# quem decide é o max_tokens_contexto deles. O resultado de ferramenta que não
# couber na reserva é cortado com um aviso explícito, para o modelo não ler uma
# lista truncada como se fosse a lista inteira.
# ─────────────────────────────────────────────
MAX_TOKENS_CONTEXTO=16000
RESERVA_FERRAMENTAS=4000

# ─────────────────────────────────────────────
# Freio de emergência do laço de ferramentas.
#
# 0 (padrão) = sem limite: o modelo chama ferramenta quantas vezes precisar, e
# quem pede parcimônia é o prompt de sistema. Ponha um número > 0 só se algum
# modelo entrar em loop de tool call — aí a rodada excedente é abortada e a
# pergunta cai para o próximo provedor da cadeia.
# ─────────────────────────────────────────────
TETO_RODADAS_FERRAMENTA=0

# Latência simulada da busca falsa do backend/app_stub.py, em segundos.
STUB_DELAY=1.2

# Porta do servidor Flask (o Render injeta esta variável automaticamente).
PORT=5000
