# ─────────────────────────────────────────────
# USPapo — variáveis de ambiente do backend
# Copie para .env e preencha. O .env NÃO vai para o git.
# ─────────────────────────────────────────────

# Pinecone — obrigatório para embeddings/app.py (o app_stub.py não usa).
PINECONE_API_KEY=

# ─────────────────────────────────────────────
# Cadeia de provedores de LLM, em ordem de prioridade.
#
# JSON em UMA linha só. O primeiro da lista é o primário; se ele falhar
# (rate limit, timeout, 5xx, chave inválida), o backend cai automaticamente
# para o próximo. Pode ter quantos você quiser.
#
# Qualquer API compatível com o protocolo OpenAI serve: Groq, OpenRouter,
# DeepSeek, OpenAI, Together, Cerebras, Ollama/LM Studio local...
#
# Campos obrigatórios por provedor:
#   nome       rótulo usado nos logs e no /health
#   base_url   endpoint compatível com OpenAI (termina em /v1)
#   model      id do modelo nesse provedor
#   api_key    valor da chave  — OU —
#   api_key_env  nome da variável de ambiente que guarda a chave (preferível,
#                evita colar segredo dentro do JSON)
#
# Campos opcionais por provedor:
#   temperature  padrão 0.1
#   max_tokens   padrão: o do provedor
#   timeout      segundos, padrão 60
#   extra_body   dict repassado cru na requisição, para flags fora do padrão
#                OpenAI (ex.: "reasoning_format" da Groq, que faz os tokens de
#                raciocínio virem separados do texto final). Atenção: nos
#                modelos gpt-oss a Groq NÃO aceita "reasoning_format", lá a
#                flag equivalente é "include_reasoning". O backend já lê o
#                raciocínio de qualquer um dos campos, então na dúvida deixe
#                o extra_body de fora.
# ─────────────────────────────────────────────
LLM_PROVIDERS=[{"nome":"groq","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY","model":"openai/gpt-oss-120b","temperature":0.1},{"nome":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key_env":"OPENROUTER_API_KEY","model":"deepseek/deepseek-chat"},{"nome":"openai","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY","model":"gpt-4o-mini"}]

# Chaves referenciadas pelos api_key_env acima.
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Rate limit: quantas perguntas cada aparelho pode fazer por janela.
#
# A chave é o aparelho (header X-Device-Id, que o site gera e guarda no
# navegador), não o IP: a rede da USP é toda NAT, então um laboratório inteiro
# sai pelo mesmo endereço e limitar por IP puniria a turma por causa de um só.
# Requisição sem o header cai no IP mesmo, senão bastava omiti-lo para escapar.
#
# As quatro janelas valem ao mesmo tempo: a de minuto segura a rajada, a de dia
# segura o uso crônico. Ponha 0 para desligar uma delas. Estourar devolve 429.
# ─────────────────────────────────────────────
RATE_LIMIT_MINUTO=8
RATE_LIMIT_10MIN=30
RATE_LIMIT_HORA=100
RATE_LIMIT_DIA=400

# ─────────────────────────────────────────────
# Orçamento de contexto — teto do que é enviado ao modelo em cada pergunta,
# não importa o tamanho da conversa acumulada no frontend. O histórico é
# cortado do turno mais antigo para o mais novo até caber; a pergunta atual
# nunca é descartada (se ela sozinha estourar, é truncada).
#
# RESERVA_FERRAMENTAS é o espaço guardado para o que as buscas ainda vão
# devolver nesta mesma pergunta — sem ela, o contexto enche antes do RAG rodar.
# ─────────────────────────────────────────────
MAX_TOKENS_CONTEXTO=16000
RESERVA_FERRAMENTAS=4000

# Porta do servidor Flask (o Render injeta esta variável automaticamente).
PORT=5000
